# Copy to .env.local. Nothing here is required.

# Signs the session cookie secret is not used; sessions are random tokens in SQLite.
# Optional model for headline tone. Without it, a built-in word list is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Notification stubs. Leave blank. The desk records "skipped" until a transport is wired.
SMTP_URL=
LINE_CHANNEL_ACCESS_TOKEN=
